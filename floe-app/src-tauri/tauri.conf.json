{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Floe",
  "version": "0.1.6",
  "identifier": "com.floe.console",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5379",
    "beforeDevCommand": "npm run build:sidecars && npm run dev",
    "beforeBuildCommand": "npm run build:sidecars && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Floe",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/floe-node"
    ],
    "resources": [
      "resources/floe-desktop.js",
      "resources/prompts/*.md"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
